<Window x:Class="MinuteFlow.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinuteFlow" Icon="assets/AppIcon.png" Width="1180" Height="850" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#EAF0FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#D3DBE8"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E1E6EF" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="◉  MinuteFlow" FontWeight="Bold" FontSize="25" Margin="8,18,0,2"/><TextBlock Text="本地会议录音" Foreground="#6A7382" Margin="8,0,0,20"/><Button x:Name="NewButton" Content="＋ 新建录音" Click="NewRecording" Background="#087CF9" Foreground="White" FontSize="17"/><TextBlock Text="最近保存" Foreground="#6A7382" Margin="8,22,0,12"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Button Content="导入录音" Click="ImportAudio"/><Button Content="⚙ 设置与检测" Click="OpenSettings"/><Button Content="打开全部会议目录" Click="OpenRoot"/><TextBlock x:Name="VersionLabel" Foreground="#8590A0" HorizontalAlignment="Center" Margin="0,6"/></StackPanel>
        <ListBox x:Name="History" SelectionChanged="HistorySelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8" Width="230"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6A7382" Margin="0,5,0,0"/><TextBlock Text="地点未记录" FontSize="11" Foreground="#8994A4" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28">
        <TextBlock Text="清晰、可靠地保存每一场会议" FontSize="25" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="完整回放和原始分轨保存在本机；AI 处理使用你配置的服务。" Foreground="#6A7382" Margin="0,0,0,18" TextWrapping="Wrap"/>
        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="TitleDisplay" Text="新录音" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" MouseLeftButtonDown="TitleDoubleClick" ToolTip="双击修改会议名称"/><TextBox x:Name="TitleEditor" Visibility="Collapsed" FontSize="21" KeyDown="TitleKeyDown" LostKeyboardFocus="TitleLostFocus"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock x:Name="TimerLabel" Text="00:00:00" FontSize="27" FontFamily="Consolas"/><TextBlock x:Name="StatusLabel" Text="准备就绪" Foreground="#168047" Margin="16,9,0,0"/></StackPanel></StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,0,0"><Button x:Name="StartButton" Content="● 开始录音" Background="#F52E3A" Foreground="White" FontSize="17" Click="StartRecording"/><StackPanel Orientation="Horizontal"><Button x:Name="PauseButton" Content="暂停" Click="PauseRecording" IsEnabled="False"/><Button x:Name="StopButton" Content="结束" Click="StopRecording" IsEnabled="False"/></StackPanel><Button x:Name="FolderButton" Content="在文件资源管理器中显示" Click="OpenMeeting"/></StackPanel>
        </Grid></Border>
        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="声音来源" FontWeight="SemiBold" FontSize="17"/><ComboBox x:Name="SourcePicker" DockPanel.Dock="Right" Width="220" SelectedIndex="0" HorizontalAlignment="Right"><ComboBoxItem Content="系统声音 + 麦克风" Tag="both"/><ComboBoxItem Content="仅麦克风" Tag="microphone"/><ComboBoxItem Content="仅系统声音" Tag="system"/></ComboBox></DockPanel><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="系统声音"/><ProgressBar x:Name="SystemMeter" Height="8" Maximum="1" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="MicLabel" Text="麦克风"/><ProgressBar x:Name="MicMeter" Height="8" Maximum="1" Margin="0,8,0,0"/></StackPanel></Grid></StackPanel></Border>
        <Border x:Name="NoticeCard" Style="{StaticResource Card}" Background="#EAF2FF"><TextBlock x:Name="NoticeLabel" Text="准备好后开始录音。" TextWrapping="Wrap" Foreground="#305A84"/></Border>
        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="会议录音" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="打开录音目录" Click="OpenMeeting" HorizontalAlignment="Right"/></DockPanel><WrapPanel><Button Content="▶ 完整回放" Click="PlayMixed"/><Button Content="▶ 麦克风原轨" Click="PlayMicrophone"/><Button Content="▶ 系统原轨" Click="PlaySystem"/><Button Content="■ 停止播放" Click="StopPlayback"/><Button x:Name="RebuildMixButton" Content="重新生成完整回放" Click="RebuildMix"/></WrapPanel><Slider x:Name="PlaybackSlider" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="PlaybackSeek" Margin="4,8"/><TextBlock x:Name="PlaybackLabel" Foreground="#6A7382"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="逐字稿 · 时间轴" FontSize="18" FontWeight="SemiBold"/><WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button x:Name="BackfillButton" Content="补全整段录音" Click="Backfill"/><Button x:Name="CancelButton" Content="取消处理" Click="CancelOperation" IsEnabled="False"/><Button Content="逐字稿文件" Click="OpenTranscript"/></WrapPanel></DockPanel><WrapPanel Margin="0,10"><ComboBox x:Name="TranscriptMode" SelectedIndex="1" SelectionChanged="TranscriptModeChanged" Width="150"><ComboBoxItem Content="原始识别"/><ComboBoxItem Content="编辑文本"/><ComboBoxItem Content="基础校正后"/></ComboBox><Button Content="基础文本校正" Click="NormalizeTranscript"/><Button x:Name="AnalyzeSpeakersButton" Content="重新分析说话人" Click="AnalyzeSpeakers"/></WrapPanel><TextBlock Text="说话人标签来自本地声学聚类，可能分错；可点击标签修改。原始识别保留用于核对。" FontSize="12" Foreground="#6A7382" TextWrapping="Wrap" Margin="0,0,0,12"/><ProgressBar x:Name="WorkProgress" Height="5" Minimum="0" Maximum="1" Visibility="Collapsed"/><ScrollViewer Height="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0"><StackPanel x:Name="TranscriptRows"/></ScrollViewer><TextBlock x:Name="PreviewLabel" TextWrapping="Wrap" Foreground="#8994A4" Margin="0,10,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AI 文档" FontSize="18" FontWeight="SemiBold"/><WrapPanel Margin="0,8"><Button x:Name="SummaryButton" Content="生成会议纪要" Click="GenerateSummary"/><Button x:Name="FormatButton" Content="AI 排版文稿" Click="GenerateDocument"/><Button x:Name="TitleButton" Content="AI 生成主题" Click="GenerateTitle"/><Button x:Name="BatchTitleButton" Content="整理历史会议主题" Click="GenerateHistoricalTitles"/><Button Content="打开文档目录" Click="OpenMeeting"/></WrapPanel><TabControl><TabItem Header="会议纪要"><TextBox x:Name="SummaryEditor" Height="260" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="SummaryTextChanged"/></TabItem><TabItem Header="AI 排版文稿"><TextBox x:Name="DocumentEditor" Height="260" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DocumentTextChanged"/></TabItem></TabControl></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
